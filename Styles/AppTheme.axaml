<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Design.PreviewWith>
    <Border Padding="20">
      <TextBlock Text="SshStudio Theme" />
    </Border>
  </Design.PreviewWith>

  <Styles.Resources>
    <Color x:Key="InkColor">#101827</Color>
    <Color x:Key="MutedColor">#728096</Color>
    <Color x:Key="PanelColor">#FFFFFF</Color>
    <Color x:Key="ShellColor">#07111F</Color>
    <Color x:Key="AccentColor">#16A085</Color>
    <Color x:Key="WarnColor">#F59E0B</Color>
    <SolidColorBrush x:Key="InkBrush" Color="{StaticResource InkColor}" />
    <SolidColorBrush x:Key="MutedBrush" Color="{StaticResource MutedColor}" />
    <SolidColorBrush x:Key="PanelBrush" Color="{StaticResource PanelColor}" />
    <SolidColorBrush x:Key="ShellBrush" Color="{StaticResource ShellColor}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
  </Styles.Resources>

  <Style Selector="Window">
    <Setter Property="FontFamily" Value="Inter, Microsoft YaHei UI" />
    <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
    <Setter Property="Background">
      <Setter.Value>
        <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
          <GradientStop Color="#EEF4F1" Offset="0" />
          <GradientStop Color="#E8EEF8" Offset="0.48" />
          <GradientStop Color="#F7EFE8" Offset="1" />
        </LinearGradientBrush>
      </Setter.Value>
    </Setter>
  </Style>

  <Style Selector="TextBlock.h1">
    <Setter Property="FontSize" Value="21" />
    <Setter Property="FontWeight" Value="800" />
    <Setter Property="LetterSpacing" Value="-0.4" />
  </Style>

  <Style Selector="TextBlock.h2">
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FontWeight" Value="700" />
  </Style>

  <Style Selector="TextBlock.caption">
    <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
    <Setter Property="FontSize" Value="12" />
  </Style>

  <Style Selector="Border.card">
    <Setter Property="Background" Value="#FDFEFE" />
    <Setter Property="CornerRadius" Value="22" />
    <Setter Property="BorderBrush" Value="#DCE7F0" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BoxShadow" Value="0 18 50 0 #220D1B2A" />
  </Style>

  <Style Selector="Border.glass">
    <Setter Property="Background" Value="#CCFFFFFF" />
    <Setter Property="CornerRadius" Value="26" />
    <Setter Property="BorderBrush" Value="#D9E5EE" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>

  <Style Selector="Button">
    <Setter Property="CornerRadius" Value="14" />
    <Setter Property="Padding" Value="14,9" />
    <Setter Property="Background" Value="#FFFFFF" />
    <Setter Property="BorderBrush" Value="#D8E4ED" />
    <Setter Property="Foreground" Value="#1D3047" />
    <Setter Property="FontWeight" Value="700" />
  </Style>

  <Style Selector="Button.primary">
    <Setter Property="Background" Value="#111D2E" />
    <Setter Property="Foreground" Value="#FFFFFF" />
    <Setter Property="BorderBrush" Value="#111D2E" />
  </Style>

  <Style Selector="Button.ghost">
    <Setter Property="Background" Value="#EDF5F3" />
    <Setter Property="BorderBrush" Value="#D2E7E2" />
    <Setter Property="Foreground" Value="#0F766E" />
  </Style>

  <Style Selector="TextBox">
    <Setter Property="CornerRadius" Value="16" />
    <Setter Property="BorderBrush" Value="#D8E4ED" />
    <Setter Property="Background" Value="#FFFFFF" />
    <Setter Property="Padding" Value="12,9" />
  </Style>

  <Style Selector="ListBox">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>

  <Style Selector="ListBoxItem">
    <Setter Property="Padding" Value="0" />
    <Setter Property="Margin" Value="0,0,0,8" />
  </Style>

  <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>
</Styles>
