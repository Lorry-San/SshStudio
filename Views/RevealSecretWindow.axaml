<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="SshStudio.Views.RevealSecretWindow"
        Width="520"
        Height="260"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Title="查看密码">
  <Border Classes="card" Margin="18" Padding="20">
    <Grid RowDefinitions="Auto,*,Auto">
      <StackPanel Spacing="6">
        <TextBlock Classes="h1" Text="{Binding Title}" />
        <TextBlock Classes="caption" Text="已通过主密码解锁，下面显示当前保存的明文。关闭窗口后不会继续显示。" />
      </StackPanel>

      <TextBox Grid.Row="1"
               Margin="0,18,0,0"
               Text="{Binding Secret}"
               IsReadOnly="True"
               TextWrapping="Wrap"
               AcceptsReturn="True" />

      <StackPanel Grid.Row="2"
                  Orientation="Horizontal"
                  HorizontalAlignment="Right"
                  Spacing="10">
        <Button Content="复制" Click="Copy" />
        <Button Classes="primary" Content="关闭" Click="CloseWindow" />
      </StackPanel>
    </Grid>
  </Border>
</Window>
